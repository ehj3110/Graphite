# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.venv312/
.venv_torch/
*.egg-info/
.eggs/
*.bak.py

# Do not leave regenerable sprint media at repo root
/*.stl
/*.png
/*.gif
/*.obj
/*.vtu

# Local-only workspaces (keep on disk; not versioned)
brain/
scratch/
result/
results/

# experiments/: track scripts/README; ignore generated output only
experiments/**/output/
experiments/**/output/**

# Large outputs — binaries and generated files not suitable for git
results/benchmark/
results/*.stl
results/*.vtk
results/*.pos
*.vtk
*.pos
mariatube_output.txt
debug_*.png
xz_flow_slice.png

# Generated outputs — ignore bulk, except Aristo/Vocal case-study handoff (see below)
outputs/diagnostics/
outputs/metrics/
outputs/implicit/
outputs/torture_tests/
outputs/supercell_phase_reviews/
outputs/test_stls/
outputs/models/
outputs/App outputs/

# Default: ignore all outputs/ binaries; exceptions follow
outputs/**
!outputs/case_studies/
!outputs/case_studies/**
!outputs/vocal/
!outputs/vocal/**

# Keep superseded cube-1mm junk local only
outputs/case_studies/cube_1mm/archive/

# Legacy broad rules (PNG/VTU under other output trees stay ignored)
outputs/**/*.png
outputs/**/*.vtu
outputs/**/*.inp
outputs/**/*.step

# Re-include cube 1mm review artifacts (figures, FEA, fluid metrics)
!outputs/case_studies/cube_1mm/**/*.png
!outputs/case_studies/cube_1mm/**/*.vtu
!outputs/case_studies/cube_1mm/**/*.json
!outputs/case_studies/cube_1mm/**/*.stl
!outputs/case_studies/cube_1mm/**/*.npy
!outputs/case_studies/cube_1mm/**/*.md

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo
