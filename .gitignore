results/tests/*.stl
Implicit_Lattice_Exploration/output/*.stl

# Topology optimization — large generated runs (keep local only)
native_topt_work/
native_topt_half_work/
native_topt_half_run.log
native_topt_console_capture.txt
optimization/runs/
vtu_telemetry/
native_jhook_*.npz
native_jhook_*.vtu
native_jhook_*_run.log
optimized_jhook_*.stl
